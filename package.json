{
  "name": "@squareboat/nest-storage",
  "version": "1.0.0",
  "description": "Multi disk multi driver storage manager for NestJS 💿💾",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs-storage",
    "nestjs-filesystem",
    "nestjs-s3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/squareboat/nestjs-storage.git"
  },
  "bugs": {
    "url": "https://github.com/squareboat/nestjs-storage/issues"
  },
  "homepage": "https://github.com/squareboat/nestjs-storage",
  "author": "Squareboat <hi@squareboat.com>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
    "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "fs-extra": "^11.4.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
